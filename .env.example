# ----------------------------------------
# .env.example - 範例環境變數檔
# 請複製為 `.env` 並在部署前填入真實值
# ----------------------------------------

# === LLM / Model 設定 ===
# OpenAI 相容或自建 LLM endpoint
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=default
# 可選：模型輸出控制
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.8


# === Database (PostgreSQL) ===
# 用於儲存故事、章節、角色等資料
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=novel


# === TTS（語音合成）設定 ===
# 若不使用 TTS，將 TTS_ENABLED 設為 false
TTS_ENABLED=false
# Fish Audio 專用參數（如使用 Fish Audio，啟用並填寫下面欄位）
#FISHAUDIO_URL=https://api.fish.audio/v1/tts
#FISHAUDIO_URL=http://localhost:8080/v1/tts
#FISHAUDIO_API_KEY=your_fishaudio_api_key
#FISHAUDIO_REFERENCE_ID=id
#FISHAUDIO_CHUNK_LENGTH=300
#FISHAUDIO_MAX_NEW_TOKENS=512
#FISHAUDIO_MEMORY_CACHE=on


# === 生成 / 上下文 設定 ===
# 用於控制回溯上下文與摘要長度
CONTEXT_FULL_EPISODES=3
CONTEXT_SUMMARY_EPISODES=20

# 全域 token 限制（如模型支援）
MAX_TOKENS=4096

# 生成溫度（0.0 - 1.0）
TEMPERATURE=0.8

# ----------------------------------------
# 範例結束 — 根據部署環境調整上述變數
# ----------------------------------------
